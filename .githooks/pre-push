#!/bin/bash

# Two guards (see docs/git-workflow.md):
#   1. Refuse a direct push to a protected branch (main/develop) — those move
#      only through PRs. This mirrors the GitHub branch-protection rules.
#   2. Validate the feature branch naming convention.

# --- 1. Block direct pushes to protected branches ---
# The hook receives, on stdin, one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>

protected='^refs/heads/(main|develop)$'
blocked=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if echo "$remote_ref" | grep -qE "$protected"; then
    echo ""
    echo "ERROR: direct push to ${remote_ref#refs/heads/} is forbidden."
    echo "  These branches move only through pull requests (see docs/git-workflow.md)."
    echo ""
    blocked=1
  fi
done
[ "$blocked" -eq 0 ] || exit 1

# --- 2. Validate branch naming ---
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

# Skip detached HEAD and the permanent branches themselves.
if [ -z "$BRANCH" ] || [ "$BRANCH" = "main" ] || [ "$BRANCH" = "develop" ]; then
  exit 0
fi

PATTERN='^(feat|fix|docs|style|refactor|perf|test|chore|ci|build)/([0-9]+-[a-z0-9-]+|[a-z0-9-]+)$'

if ! echo "$BRANCH" | grep -qE "$PATTERN"; then
  echo ""
  echo "ERROR: Invalid branch name: $BRANCH"
  echo "  Expected: type/number-description (e.g., feat/12-crdt-model)"
  echo "  Types: feat|fix|docs|style|refactor|perf|test|chore|ci|build"
  echo ""
  exit 1
fi

exit 0
